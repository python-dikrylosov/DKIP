venv/
env/
ENV/
.venv

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Models (большие файлы)
models/*
!models/.gitkeep

# Logs
logs/*.log
logs/*.txt
*.log

# Environment variables
.env
*.env
!config/.env.example

# OS
.DS_Store
Thumbs.db

# Temporary files
tmp/
temp/
*.tmp

# Jupyter Notebook
